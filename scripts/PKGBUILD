# Maintainer: Marco Kellershoff <marco@kellershoff.net>

pkgname=p2p-kiwi-bin
_pkgname=p2p-kiwi
pkgver=0.0.0 # CI will take care
pkgrel=1
pkgdesc="P2P screen sharing for Mac, Windows, and Linux."
arch=('x86_64')
url="https://github.com/dont-be-evil-company/p2p.kiwi"
license=('MIT')
depends=('nss' 'at-spi2-core' 'libxss' 'gtk3' 'alsa-lib' 'libxtst')
install=p2p-kiwi.install
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("https://github.com/dont-be-evil-company/p2p.kiwi/releases/download/v${pkgver}/p2p-kiwi_amd64.deb")
sha256sums=('PASTE_LATEST_DEB_HASH_HERE')

package() {
  if [ -f "data.tar.xz" ]; then
    bsdtar -xf "data.tar.xz" -C "${pkgdir}"
  else
    bsdtar -xf "data.tar.gz" -C "${pkgdir}"
  fi
  mkdir -p "${pkgdir}/usr/bin"
  local exec_path
  exec_path="$(find "${pkgdir}/opt" -maxdepth 2 -type f \( -name "${_pkgname}" -o -name 'p2p.kiwi' \) | head -n 1 || true)"
  if [[ -n "$exec_path" ]]; then
    ln -sf "${exec_path#"$pkgdir"}" "${pkgdir}/usr/bin/${_pkgname}"
  fi
  local sandbox
  sandbox="$(find "${pkgdir}" -name chrome-sandbox -type f | head -n 1 || true)"
  if [[ -n "$sandbox" ]]; then
    chmod 4755 "$sandbox"
  fi
  local rules
  rules="$(find "${pkgdir}" -path '*/udev/70-p2p-kiwi-input.rules' -type f | head -n 1 || true)"
  if [[ -n "$rules" ]]; then
    install -Dm644 "$rules" "${pkgdir}/usr/lib/udev/rules.d/70-p2p-kiwi-input.rules"
  fi
}
